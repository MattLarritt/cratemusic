# crate configuration. Copy to .env and edit.
#
# Only the two directories below are required. Everything else has a working
# default or disables a feature by its absence — crate starts with an empty .env
# and tells you in the boot log which integrations are off.

# ---- required: your two directories -----------------------------------------
# Your music library, as the HOST sees it.
CRATE_MUSIC_DIR=/srv/music
# Where your download client puts finished files. MUST be a different tree from
# the library above; crate refuses to start if they are the same.
CRATE_DOWNLOADS_DIR=/srv/downloads

# What address the container's port 8080 binds to on the host. Default is
# loopback only, which is the right default: crate has no rate limiting of its
# own and is meant to sit behind a reverse proxy. Use 0.0.0.0 to expose it to
# your LAN directly.
CRATE_BIND=127.0.0.1

# ---- first sign-in ----------------------------------------------------------
# Creates an admin on first boot if there are no users yet. Remove both after
# your account exists — they are read only when the users table is empty.
CRATE_BOOTSTRAP_USER=admin
CRATE_BOOTSTRAP_PASSWORD=change-me

# Set to 1 if you reach crate over plain HTTP (e.g. a trusted LAN with no TLS).
# Otherwise the session cookie is Secure-only and sign-in will appear to fail
# silently — this is the single most common setup problem.
# CRATE_COOKIE_INSECURE=1

# ---- recommendations (optional) ---------------------------------------------
# Last.fm API key. Powers artist similarity; without it, "similar artists" and
# parts of Discover fall back to the library listing.
# Free key: https://www.last.fm/api/account/create
CRATE_LASTFM_KEY=

# OpenAI, used ONLY as an arbiter: breaking ties the rules engine cannot settle
# when matching messy filenames, and building playlists from a text prompt.
# Absent means both features are off; nothing else changes.
OPENAI_API_KEY=
# CRATE_OPENAI_URL=https://api.openai.com/v1

# ---- acquisition (optional) --------------------------------------------------
# crate can find and download music itself. Point it at what you already run.
# Prowlarr provides indexers; SABnzbd handles Usenet; qBittorrent handles
# torrents. Any subset works — with none of them, crate manages the library you
# already have.
CRATE_PROWLARR_URL=
CRATE_PROWLARR_KEY=
CRATE_SAB_URL=
CRATE_SAB_KEY=
CRATE_SAB_CATEGORY=music
CRATE_QBIT_URL=
CRATE_QBIT_USER=
CRATE_QBIT_PASSWORD=

# ---- identification (optional) ----------------------------------------------
# AcoustID identifies audio by how it SOUNDS, for files whose tags lie. crate's
# image ships fpcalc (chromaprint) already; this is just the API key.
# Free key: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# MusicBrainz asks that clients identify themselves. Change this if you run a
# fork so their operators can reach the right person.
# CRATE_MB_USER_AGENT=crate/0.1 ( https://github.com/MattLarritt/cratemusic )

# ---- limits (optional) ------------------------------------------------------
# Guard rails for non-admin users. 0 means unlimited.
CRATE_MAX_ALBUMS_PER_REQUEST=0
CRATE_DAILY_ALBUM_CAP=0
# How long a download may sit at 0% before crate calls it stalled.
CRATE_STALL_MINUTES=30

# ---- automation (optional) --------------------------------------------------
# Bearer token for callers with no browser session (scripts, home automation).
# Absent closes those endpoints entirely.
CRATE_API_KEY=

# ---- paths inside the container (rarely changed) ----------------------------
# CRATE_DB=/data/crate.db
# CRATE_MUSIC_ROOT=/music
# CRATE_TRASH_ROOT=/downloads/.crate-trash
# CRATE_UPLOAD_STAGING=/downloads/.crate-uploads
# CRATE_ADOPT_ROOT=/downloads/usenet/music
# CRATE_LOG=info
TZ=UTC
